# Ref:
# - https://wiki.alpinelinux.org/wiki/Alpine_setup_scripts#setup-alpine
# - https://gitlab.alpinelinux.org/alpine/alpine-conf/-/blob/master/setup-alpine.in?ref_type=heads

# Use US layout with US variant
KEYMAPOPTS="us us"

# Set hostname to alpine-test
HOSTNAMEOPTS="-n alpine-vm-arm64"

# Contents of /etc/network/interfaces
INTERFACESOPTS="auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
hostname alpine-vm-arm64
"

# Search domain of example.com, Google public nameserver
DNSOPTS="-n 8.8.8.8"

# Set timezone to UTC
TIMEZONEOPTS="-z UTC"

# set http/ftp proxy
PROXYOPTS="none"

# Add a random mirror
APKREPOSOPTS="-f"

# Disabling create additional user
USEROPTS="none"

# Install Openssh
SSHDOPTS="-c openssh"

# Use openntpd
NTPOPTS="-c openntpd"

# Use /dev/sda as a data disk
DISKOPTS="-m sys /dev/sda"
